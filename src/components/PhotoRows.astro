---
// Photos d'une série, deux par ligne (une sur mobile) : chaque photo garde
// son format, les deux photos d'une ligne ont la même hauteur.
import { Image } from 'astro:assets';
import type { Series } from '../lib/series';
import { getPhotos, photoAlt } from '../lib/series';

interface Props {
  series: Series;
}

const { series } = Astro.props;
const photos = getPhotos(series);
const polaroid = series.data.format === 'polaroid';
const ratios = photos.map((photo) => photo.src.width / photo.src.height);

// Somme des ratios de la ligne : chaque photo y prend une largeur
// proportionnelle à son ratio. Une photo seule en fin de série compte
// double, pour garder une demi-largeur.
const rowRatio = (index: number) => {
  const first = index - (index % 2);
  return ratios[first] + (ratios[first + 1] ?? ratios[first]);
};
---

<ul class:list={['rows', { polaroid }]} role="list">
  {
    photos.map((photo, index) => {
      const ratio = ratios[index];
      return (
        <li style={`--ratio: ${ratio.toFixed(4)}; --row-ratio: ${rowRatio(index).toFixed(4)}`}>
          <a href={`/portfolio/${series.id}/${photo.slug}/`} data-slug={photo.slug}>
            <Image
              src={photo.src}
              alt={photoAlt(series, photo, index)}
              widths={[480, 800, 1200]}
              sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
            />
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .rows {
    --gap: var(--gap-photos);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  li {
    width: calc((100% - var(--gap)) * var(--ratio) / var(--row-ratio));
    min-width: 0;
  }

  a {
    display: block;
  }

  img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    background: var(--soft);
    transition: opacity 0.15s;
  }

  a:hover img {
    opacity: 0.88;
  }

  .polaroid {
    --gap: 24px;
    background: #eef0f3;
    padding: 32px;
  }

  .polaroid img {
    box-shadow: 0 1px 3px rgba(17, 18, 20, 0.18);
  }

  @media (max-width: 640px) {
    li {
      width: 100%;
    }

    .polaroid {
      --gap: 16px;
      padding: 16px;
    }
  }
</style>
