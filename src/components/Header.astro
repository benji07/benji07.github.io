---
import { SITE } from '../lib/site';

interface Props {
  current?: 'home' | 'initiations' | 'portfolio' | 'blog';
}

const { current } = Astro.props;
const links = [
  { href: '/initiations/', label: 'Initiations', key: 'initiations' },
  { href: '/portfolio/', label: 'Portfolio', key: 'portfolio' },
];
---

<header class="header mono">
  {current === 'home' ? <span /> : <a class="home" href="/">{SITE.name}</a>}
  <nav aria-label="Navigation principale">
    {
      links.map((link) =>
        current === link.key ? (
          <span aria-current="page">{link.label}</span>
        ) : (
          <a href={link.href}>{link.label}</a>
        ),
      )
    }
    <a class:list={{ 'hide-mobile': current !== 'home' }} href={SITE.instagram}>Instagram ↗</a>
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    min-height: 44px;
    font-size: 13px;
  }

  .home {
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  nav a,
  nav span {
    padding: 12px 0;
    color: var(--muted);
  }

  nav [aria-current] {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    nav {
      gap: 0 16px;
    }

    /* Sur les pages internes, le nom + 3 liens ne tiennent pas sur une ligne. */
    .hide-mobile {
      display: none;
    }
  }
</style>
