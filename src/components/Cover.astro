---
// Couverture d'une série : la photo, entière, centrée dans un carré gris
// uni. Les Polaroid gardent leur cadre (le scan l'inclut).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  polaroid?: boolean;
}

const { src, alt, polaroid = false } = Astro.props;
---

<div class="cover">
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 720]}
    sizes="(max-width: 960px) 45vw, 30vw"
    class:list={['photo', { polaroid }]}
  />
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 1;
    background: var(--soft);
  }

  /* En absolu, la photo ne peut pas agrandir le carré : sans ça, une photo
     en portrait l'étirait en hauteur et les cartes n'avaient pas la même
     taille. */
  .photo {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 88%;
    max-height: 88%;
    width: auto;
    height: auto;
  }
</style>
