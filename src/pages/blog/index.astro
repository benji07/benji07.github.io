---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.date.getUTCFullYear());
---

<BaseLayout title="Blog" current="blog" description="Archives de mon blog (2009–2016) : Symfony, Doctrine, PHP.">
  <main class="blog">
    <div class="intro">
      <h1>Blog</h1>
      <p class="prose">
        Mes articles techniques de {posts.at(-1)?.date.getUTCFullYear()} à {posts[0]?.date.getUTCFullYear()}, surtout
        sur Symfony et Doctrine. Je ne publie plus ici ; ils restent en ligne en l'état, certains sont sûrement
        dépassés.
      </p>
    </div>
    {
      [...years].map(([year, items]) => (
        <section aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`} class="label">{year}</h2>
          <ul role="list">
            {items.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                <time class="mono" datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .blog {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 820px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .intro .prose {
    margin: 0;
    max-width: 60ch;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h2 {
    margin: 0;
    font-weight: 400;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  li a {
    color: var(--fg);
    font-weight: 500;
  }

  time {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
