---
import LaboTool from '../../components/LaboTool.astro';
import { computeFormat, DEFAULTS, NEGATIVES } from '../../lib/labo/format';

const result = computeFormat(DEFAULTS);
// Proportions du dessin : la plus grande image fait 100 %.
const max = Math.max(DEFAULTS.from, DEFAULTS.to);
---

<LaboTool id="changement-de-format">
  <div class="tool">
    <form class="tool__form format-form" id="format-form">
      <label class="field">
        <span class="field__label">Négatif</span>
        <select class="input" name="negative">
          {NEGATIVES.map((neg) => <option value={neg.size} selected={neg.label === '24 × 36'}>{neg.label}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="field__label">Temps actuel (s)</span>
        <input class="input" name="time" type="number" inputmode="decimal" min="0.5" step="any" value={DEFAULTS.time} />
      </label>
      <label class="field">
        <span class="field__label">Grand côté actuel (cm)</span>
        <input class="input" name="from" type="number" inputmode="decimal" min="5" step="any" value={DEFAULTS.from} />
      </label>
      <label class="field">
        <span class="field__label">Nouveau grand côté (cm)</span>
        <input class="input input--strong" name="to" type="number" inputmode="decimal" min="5" step="any" value={DEFAULTS.to} />
      </label>
    </form>

    <section class="tool__result" aria-live="polite">
      <div class="result">
        <span class="result__label">Correction</span>
        <output class="result__value format__stops" id="format-stops" form="format-form">{result.stops}</output>
        <span class="format__same" id="format-same">{result.same}</span>
        <span class="result__detail" id="format-aperture">{result.aperture}</span>
      </div>

      <div class="sizes" aria-hidden="true">
        <span class="sizes__print" id="format-from" style={`width: ${(DEFAULTS.from / max) * 100}%`}>{DEFAULTS.from} cm</span>
        <span class="sizes__print sizes__print--new" id="format-to" style={`width: ${(DEFAULTS.to / max) * 100}%`}>{DEFAULTS.to} cm</span>
      </div>
    </section>
  </div>
</LaboTool>

<style>
  .format-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }

  .format-form .input {
    width: 100%;
  }

  .input--strong {
    border-color: var(--fg);
  }

  .format__stops {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .format__same {
    padding-top: 6px;
    font-size: 16px;
    font-weight: 600;
  }

  .result__detail {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Les deux tirages à l'échelle, posés sur le plateau. */
  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 16px;
    background: var(--soft);
  }

  .sizes__print {
    flex: none;
    max-width: calc(50% - 8px);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    padding: 6px;
    background: var(--bg);
    border: 1px solid var(--field-line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    transition: width 0.3s ease;
  }

  .sizes__print--new {
    border-color: var(--fg);
    color: var(--fg);
  }
</style>

<script>
  import { computeFormat, DEFAULTS, type FormatSettings } from '../../lib/labo/format';
  import { readNumber } from '../../lib/labo/math';
  import { load, save } from '../../lib/labo/store';

  const KEY = 'format';
  const form = document.querySelector<HTMLFormElement>('#format-form')!;
  const negative = form.querySelector<HTMLSelectElement>('select[name="negative"]')!;
  const input = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
  const stops = document.querySelector<HTMLOutputElement>('#format-stops')!;
  const same = document.querySelector<HTMLElement>('#format-same')!;
  const aperture = document.querySelector<HTMLElement>('#format-aperture')!;
  const fromBox = document.querySelector<HTMLElement>('#format-from')!;
  const toBox = document.querySelector<HTMLElement>('#format-to')!;

  function restore() {
    const stored = load<FormatSettings & { negativeIndex: number }>(KEY);
    if (!stored) return;
    // 4,5 × 6 et 6 × 6 ont le même grand côté : on garde l'option choisie.
    if (typeof stored.negativeIndex === 'number' && negative.options[stored.negativeIndex]) {
      negative.selectedIndex = stored.negativeIndex;
    }
    for (const name of ['time', 'from', 'to'] as const) {
      if (typeof stored[name] === 'number') input(name).value = String(stored[name]);
    }
  }

  function update() {
    const settings: FormatSettings = {
      negative: Number(negative.value) || DEFAULTS.negative,
      time: readNumber(input('time')),
      from: readNumber(input('from')),
      to: readNumber(input('to')),
    };
    if (!(settings.time > 0 && settings.from > 0 && settings.to > 0)) {
      stops.textContent = '–';
      same.textContent = 'Remplis les valeurs avec des nombres supérieurs à 0.';
      aperture.textContent = '';
      return;
    }
    save(KEY, { ...settings, negativeIndex: negative.selectedIndex });

    const result = computeFormat(settings);
    stops.textContent = result.stops;
    same.textContent = result.same;
    aperture.textContent = result.aperture;

    const max = Math.max(settings.from, settings.to);
    fromBox.style.width = `${(settings.from / max) * 100}%`;
    toBox.style.width = `${(settings.to / max) * 100}%`;
    fromBox.textContent = `${settings.from} cm`;
    toBox.textContent = `${settings.to} cm`;
  }

  restore();
  update();
  form.addEventListener('input', update);
  form.addEventListener('submit', (event) => event.preventDefault());
</script>
