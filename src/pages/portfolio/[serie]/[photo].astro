---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoInfo from '../../../components/PhotoInfo.astro';
import { getSeries, getPhotos, photoAlt, photoTitle, type Series, type SeriesPhoto } from '../../../lib/series';

export async function getStaticPaths() {
  const all = await getSeries();
  return all.flatMap((series) => {
    const photos = getPhotos(series);
    return photos.map((photo, index) => ({
      params: { serie: series.id, photo: photo.slug },
      props: { series, photo, index, previous: photos[index - 1], next: photos[index + 1] },
    }));
  });
}

interface Props {
  series: Series;
  photo: SeriesPhoto;
  index: number;
  previous?: SeriesPhoto;
  next?: SeriesPhoto;
}

const { series, photo, index, previous, next } = Astro.props;
const alt = photoAlt(series, photo, index);
const title = photoTitle(series, photo, index);
const og = await getImage({ src: photo.src, width: 1200, format: 'jpg' });

const base = `/portfolio/${series.id}`;
---

<BaseLayout title={title} current="portfolio" ogImage={og.src} description={photo.description ?? `${series.data.title} : ${title}`}>
  <main class="photo-page">
    <nav class="nav mono" aria-label="Navigation dans la série">
      <a class="back" href={`${base}/`}><span aria-hidden="true">←</span> {series.data.title}</a>
      <span class="arrows">
        {previous ? <a href={`${base}/${previous.slug}/`} aria-label="Photo précédente"><span aria-hidden="true">←</span> Précédente</a> : <span />}
        {next && <a href={`${base}/${next.slug}/`} aria-label="Photo suivante">Suivante <span aria-hidden="true">→</span></a>}
      </span>
    </nav>

    <div class="layout">
      <div class="stage">
        {previous ? <a class="arrow mono" href={`${base}/${previous.slug}/`} aria-label="Photo précédente">←</a> : <span />}
        <figure class="frame">
          <Image src={photo.src} alt={alt} widths={[640, 1024, 1600, 2048]} sizes="(max-width: 960px) 100vw, 66vw" loading="eager" />
        </figure>
        {next ? <a class="arrow mono" href={`${base}/${next.slug}/`} aria-label="Photo suivante">→</a> : <span />}
      </div>

      <div class="info">
        <PhotoInfo series={series} photo={photo} index={index} />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .photo-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-page);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .arrows {
    display: flex;
    gap: 20px;
  }

  .arrows a {
    color: var(--muted);
    padding: 12px 0;
  }

  /* Cadre gris de la photo. Sur mobile, les flèches passent de part et
     d'autre de la photo, dans le cadre ; sur ordinateur elles restent en haut. */
  .stage {
    min-width: 0;
    background: var(--soft);
    display: grid;
    align-items: center;
  }

  .stage > :not(.frame) {
    display: none;
  }

  .arrow {
    justify-content: center;
    padding: 24px 0;
    font-size: 20px;
    color: var(--muted);
    text-decoration: none;
  }

  .arrow:hover {
    color: var(--fg);
  }

  /* Photo 2/3, détails 1/3 : comme les pages série et workshop. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-page) var(--gap-columns);
    align-items: start;
  }

  .frame {
    min-width: 0;
    margin: 0;
    padding: 32px;
    display: flex;
    justify-content: center;
  }

  .frame img {
    max-height: 80vh;
    width: auto;
    object-fit: contain;
  }

  .info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .arrows {
      display: none;
    }

    .stage {
      grid-template-columns: 32px minmax(0, 1fr) 32px;
      margin: 0 calc(-1 * var(--gutter));
    }

    .stage > :not(.frame) {
      display: flex;
    }

    .frame {
      padding: 12px 0;
    }
  }
</style>
