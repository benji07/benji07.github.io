---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoRows from '../../../components/PhotoRows.astro';
import { getSeries, getCover, seriesMeta, type Series } from '../../../lib/series';

export async function getStaticPaths() {
  const all = await getSeries();
  return all.map((series, index) => ({
    params: { serie: series.id },
    props: { series, previous: all[index + 1], next: all[index - 1] },
  }));
}

interface Props {
  series: Series;
  previous?: Series;
  next?: Series;
}

const { series, previous, next } = Astro.props;
const { Content } = await render(series);
const og = await getImage({ src: getCover(series), width: 1200, format: 'jpg' });
---

<BaseLayout title={series.data.title} current="portfolio" ogImage={og.src}>
  <main class="serie">
    <aside class="text">
      <a class="back mono" href="/portfolio/">← Toutes les séries</a>
      <h1>{series.data.title}</h1>
      <span class="label">{seriesMeta(series)}</span>
      <div class="prose"><Content /></div>
      {
        (previous || next) && (
          <nav class="siblings mono" aria-label="Autres séries">
            {previous ? <a href={`/portfolio/${previous.id}/`}>← Série précédente</a> : <span />}
            {next && <a href={`/portfolio/${next.id}/`}>Suivante →</a>}
          </nav>
        )
      }
    </aside>
    <div class="photos">
      <PhotoRows series={series} />
    </div>
  </main>
</BaseLayout>

<style>
  .serie {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: flex-start;
  }

  .text {
    flex: 1 1 300px;
    max-width: 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 24px;
  }

  .photos {
    flex: 999 1 600px;
    min-width: 0;
  }

  .back {
    font-size: 13px;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .prose {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .siblings {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    font-size: 13px;
  }

  .siblings a {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .text {
      position: static;
      max-width: none;
    }

    h1 {
      font-size: 36px;
    }

    .siblings {
      order: 3;
    }
  }
</style>
